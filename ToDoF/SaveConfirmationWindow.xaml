<Window x:Class="ToDoF.SaveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoF"
        mc:Ignorable="d"
        Title="SaveConfirmationWindow" Height="220" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#111111"
        AllowsTransparency="True">

    <Border Background="#111111"
            BorderBrush="Gray"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Do you want to save your tasks?"
                       Foreground="White"
                       FontSize="20"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">

                <Button Content="Yes"
                        Width="100"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Gray"
                        BorderThickness="1.2"
                        Click="Yes_Click"/>

                <Button Content="No"
                        Width="100"
                        Height="38"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="Gray"
                        BorderThickness="1.2"
                        Click="No_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
